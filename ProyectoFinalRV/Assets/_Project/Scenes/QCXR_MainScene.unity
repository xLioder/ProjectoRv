  startButtonId: StartShift
  skipButtonId: SkipTutorial
  steps:
  - instruction: "Mu\xE9vete con el joystick izquierdo y gira con el derecho."
    completeOn: 0
  - instruction: "Agarra una herramienta de la mesa con el bot\xF3n de agarre (grip)."
    completeOn: 1
  - instruction: "LUPA: ac\xE9rcala al producto y mira por el lente para revelar defectos ocultos."
    completeOn: 2
  - instruction: "DESTORNILLADOR: apoya la punta en el tornillo flojo y mant\xE9n el gatillo."
    completeOn: 3
  - instruction: 'MARTILLO: golpea la abolladura con fuerza para enderezarla.'
    completeOn: 4
  - instruction: Las grietas y circuitos quemados NO se reparan. Suelta el producto en el cubo de desecho.
    completeOn: 5
  - instruction: "Reporta el da\xF1o en el panel: elige qu\xE9 defecto ten\xEDa el producto."
    completeOn: 6
  - instruction: "\xA1Listo! Lo sano o reparado va al estante de su tipo. Presiona INICIAR TURNO."
    completeOn: 7
